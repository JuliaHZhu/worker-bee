{
  "version": "1.0",
  "description": "TODO Ball Machine - 调度配置",
  
  "heartbeat": {
    "enabled": true,
    "check_interval_min": 30,
    "tasks": {
      "daily_todo_check": {
        "enabled": false,
        "description": "每日TODO Ball Machine状态检查",
        "frequency": "every_30_min"
      },
      "cycle_review": {
        "enabled": true,
        "description": "7天周度周期盘点",
        "time": "00:30"
      },
      "ball_pool_maintenance": {
        "enabled": false,
        "description": "抽彩球池维护",
        "frequency": "hourly"
      }
    }
  },
  
  "cron": {
    "enabled": true,
    "reminders": [
      {
        "id": "anchor_outing",
        "name": "出门提醒",
        "cron_expr": "0 9 * * *",
        "timezone": "Asia/Kuala_Lumpur",
        "message": "🌅 轻锚定提醒：9-9:30出门时间到！KL的餐厅10点开门，出门可以提高生产力还能使用运动设施哦~",
        "enabled": true
      },
      {
        "id": "draw_am",
        "name": "上午场抽球提醒",
        "cron_expr": "15 9 * * *",
        "timezone": "Asia/Kuala_Lumpur",
        "message": "🎲 提醒：抽取今日上午场色球！使用 `todo_dealer draw am` 或 `todo_dealer quick`",
        "enabled": true
      },
      {
        "id": "draw_pm",
        "name": "下午场抽球提醒",
        "cron_expr": "45 13 * * *",
        "timezone": "Asia/Kuala_Lumpur",
        "message": "🎲 提醒：抽取今日下午场色球！使用 `todo_dealer draw pm` 或 `todo_dealer quick`",
        "enabled": true
      },
      {
        "id": "draw_evening",
        "name": "晚间场抽球提醒",
        "cron_expr": "45 18 * * *",
        "timezone": "Asia/Kuala_Lumpur",
        "message": "🎲 提醒：抽取今日晚间场色球！使用 `todo_dealer draw evening` 或 `todo_dealer quick`",
        "enabled": true
      },
      {
        "id": "anchor_bedtime",
        "name": "睡前记录提醒",
        "cron_expr": "50 21 * * *",
        "timezone": "Asia/Kuala_Lumpur",
        "message": "🌙 轻锚定提醒：10分钟睡前记录时间到！记录今天的状态、今日三件事、明天三件事~",
        "enabled": true
      },
      {
        "id": "weekly_report",
        "name": "周度报告",
        "cron_expr": "0 8 * * 1",
        "timezone": "Asia/Kuala_Lumpur",
        "message": "📊 提醒：生成上周TODO系统运行报告！",
        "enabled": true
      }
    ]
  },
  
  "menstrual_cycle": {
    "enabled": true,
    "cycle_length": 30,
    "affected_start": -10,
    "affected_end": -2,
    "adjustments": {
      "ball_pool_ratio": {
        "治愈休息": 1.5,
        "健康运动": 0.5
      },
      "difficulty_modifier": 0.8
    }
  },
  
  "integration": {
    "life_record_sync": false,
    "auto_log_to_life_record": false
  }
}
